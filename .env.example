# Copia este archivo a .env y rellena los valores. En GitHub van como Secrets.
HELIUS_API_KEY=
# Cadena de conexión de Supabase (Settings > Database > Connection string > URI, modo "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Opcional: Birdeye (plan gratis) para descubrir top traders
BIRDEYE_API_KEY=
# Copier en tiempo real: URL de la Edge Function y secreto que Helius envía como cabecera Authorization
WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/copier-webhook
WEBHOOK_SECRET=
